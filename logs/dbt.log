    create  table
      dev.gold.mart_vendas_por_vendedor__dbt_tmp
  
    as (
      with base as (

    select
        f.id_vendas,
        f.ano_mes_venda as ano_mes,
        f.id_vendedores,
        v.nome as vendedor,
        v.concessionaria,
        e.estado,
        e.sigla,
        f.id_clientes,
        f.valor_pago,
        f.valor_desconto
    from dev.gold.fct_vendas as f
    left join dev.gold.dim_vendedor as v
        on f.id_vendedores = v.id_vendedores
    left join dev.gold.dim_estado as e
        on f.id_estados = e.id_estados

),

agregado as (

    select
        ano_mes,
        id_vendedores,
        vendedor,
        concessionaria,
        estado,
        sigla,
        count(id_vendas) as quantidade_vendas,
        sum(valor_pago) as receita_total,
        avg(valor_desconto) as desconto_medio,
        count(distinct id_clientes) as clientes_unicos
    from base
    group by ano_mes, id_vendedores, vendedor, concessionaria, estado, sigla

),

com_janelas as (

    select
        agregado.*,
        case
        when quantidade_vendas is null or quantidade_vendas = 0 then null
        else (receita_total) / (quantidade_vendas)
    end as ticket_medio,
        rank() over (partition by ano_mes order by receita_total desc) as ranking_vendedor,
        lag(receita_total) over (partition by id_vendedores order by ano_mes) as receita_mes_anterior
    from agregado

)

select
    ano_mes,
    id_vendedores,
    vendedor,
    concessionaria,
    estado,
    sigla,
    quantidade_vendas,
    receita_total,
    ticket_medio,
    desconto_medio,
    clientes_unicos,
    ranking_vendedor,
    case
        when receita_mes_anterior is null or receita_mes_anterior = 0 then null
        else (receita_total - receita_mes_anterior) / (receita_mes_anterior)
    end as crescimento_mensal,
    current_timestamp as _dbt_processed_at,
    'f560fd09-d00f-489c-82a7-1988eccb0a15' as _dbt_invocation_id
from com_janelas
    );
  
  
