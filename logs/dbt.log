    create temporary table
      silver_cidades__dbt_tmp20261014110619868499
  
    as (
      

with source as (

    select
        id_cidades,
        
    nullif(
        trim(
            regexp_replace(cast(cidade as varchar), '\s+', ' ', 'g')
        ), 
        ''
    )
 as cidade,
        id_estados,
        data_inclusao,
        data_atualizacao,
        greatest(
        coalesce(data_inclusao, timestamp '1900-01-01 00:00:00'),
        coalesce(data_atualizacao, timestamp '1900-01-01 00:00:00')
    ) as _source_modified_at
    from dev.bronze.bronze_cidades
    where id_cidades is not null

    
    and _source_modified_at >= (
        select coalesce(max(_source_modified_at), timestamp '1900-01-01 00:00:00')
        from dev.silver.silver_cidades
    ) - interval '5 minutes'
    

),

ranked as (

    select
        source.*,
        row_number() over (
            partition by id_cidades
            order by _source_modified_at desc
        ) as _rn
    from source

),

deduplicated as (

    select
        id_cidades,
        cidade,
        id_estados,
        data_inclusao,
        data_atualizacao,
        _source_modified_at
    from ranked
    where _rn = 1

)

select
    id_cidades,
    cidade,
    id_estados,
    data_inclusao,
    data_atualizacao,
    _source_modified_at,
    current_timestamp as _dbt_processed_at,
    '7db67ae8-484a-40a2-81a7-8261d7e57cd7' as _dbt_invocation_id
from deduplicated
    );
  
  
  
