        select coalesce(max(_source_modified_at), timestamp '1900-01-01 00:00:00')
        from dev.silver.silver_clientes
    ) - interval '5 minutes'
    

),

ranked as (

    select
        source.*,
        row_number() over (
            partition by id_clientes
            order by _source_modified_at desc
        ) as _rn
    from source

),

deduplicated as (

    select
        id_clientes,
        cliente,
        endereco,
        id_concessionarias,
        data_inclusao,
        data_atualizacao,
        _source_modified_at
    from ranked
    where _rn = 1

)

select
    id_clientes,
    cliente,
    endereco,
    id_concessionarias,
    data_inclusao,
    data_atualizacao,
    _source_modified_at,
    current_timestamp as _dbt_processed_at,
    '5c7a3755-52d1-4103-aa9c-5b295ac20cb3' as _dbt_invocation_id
from deduplicated
    );
  
  
  
