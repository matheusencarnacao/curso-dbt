    create  table
      dev.silver.silver_estados
  
    as (
      

with source as (
    select 
        id_estados,
        
    nullif(
        trim(
            regexp_replace(cast(estado as varchar), '\s+', ' ', 'g')
        ), 
        ''
    )
 as estado,
        
    upper(
    nullif(
        trim(
            regexp_replace(cast(sigla as varchar), '\s+', ' ', 'g')
        ), 
        ''
    )
)
 as sigla,
        data_inclusao,
        data_atualizacao,
        greatest(
        coalesce(data_inclusao, timestamp '1900-01-01 00:00:00'),
        coalesce(data_atualizacao, timestamp '1900-01-01 00:00:00')
    ) as _source_modified_at
    from dev.bronze.bronze_estados
    where id_estados is not null
    
),
ranked as (
    select 
        source.*,
        row_number() over (partition by id_estados order by _source_modified_at desc) as row_num
    from source
),
deduplicated as (
    select
        id_estados,
        estado,
        sigla,
        data_inclusao,
        data_atualizacao,
        _source_modified_at
    from ranked
    where row_num = 1
),
enriched as (
    select 
        d.id_estados,
        d.estado,
        d.sigla,
        r.regiao,
        r.ordem_regiao,
        d.data_inclusao,
        d.data_atualizacao,
        d._source_modified_at
    from deduplicated d
    left join dev.seeds.seed_regioes_estados as r 
    on d.sigla = r.sigla
)   

select
        id_estados,
        estado,
        sigla,
        regiao,
        ordem_regiao,
        data_inclusao,
        data_atualizacao,
        _source_modified_at,
        current_timestamp as _dbt_processed_at,
    '8d019073-cfbb-493f-8059-c6e8ea4213e3' as _dbt_invocation_id
 from enriched
    );
  
  
  
