        nome,
        tipo_normalizado,
        valor,
        data_inclusao,
        data_atualizacao,
        _source_modified_at
    from ranked
    where _rn = 1

),

tipo_enriquecido as (

    select
        d.id_veiculos,
        d.nome,
        d.tipo_normalizado as tipo,
        coalesce(t.tipo_padronizado, d.tipo_normalizado) as tipo_padronizado,
