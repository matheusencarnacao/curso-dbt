    create  table
      dev.gold.mart_vendas_por_concessionaria__dbt_tmp
  
    as (
      with base as (

    select
        f.id_vendas,
        f.ano_mes_venda as ano_mes,
        f.id_concessionarias,
        c.concessionaria,
        c.cidade,
        c.estado,
        c.sigla,
        c.regiao,
        f.id_clientes,
        f.id_vendedores,
        f.valor_pago,
        f.valor_desconto
    from dev.gold.fct_vendas as f
    left join dev.gold.dim_concessionaria as c
        on f.id_concessionarias = c.id_concessionarias

),

agregado as (

    select
        ano_mes,
        id_concessionarias,
        concessionaria,
        cidade,
        estado,
        sigla,
        regiao,
        count(id_vendas) as quantidade_vendas,
        sum(valor_pago) as receita_total,
        avg(valor_desconto) as desconto_medio,
        count(distinct id_clientes) as clientes_unicos,
        count(distinct id_vendedores) as vendedores_ativos
    from base
    group by ano_mes, id_concessionarias, concessionaria, cidade, estado, sigla, regiao

),

com_janelas as (

    select
        agregado.*,
        case
        when quantidade_vendas is null or quantidade_vendas = 0 then null
        else (receita_total) / (quantidade_vendas)
    end as ticket_medio,
        case
        when sum(receita_total) over (partition by ano_mes) is null or sum(receita_total) over (partition by ano_mes) = 0 then null
        else (receita_total) / (sum(receita_total) over (partition by ano_mes))
    end as participacao_receita,
        rank() over (partition by ano_mes order by receita_total desc) as ranking_concessionaria,
        lag(receita_total) over (partition by id_concessionarias order by ano_mes) as receita_mes_anterior
    from agregado

)

select
    ano_mes,
    id_concessionarias,
    concessionaria,
    cidade,
    estado,
    sigla,
    regiao,
    quantidade_vendas,
    receita_total,
    ticket_medio,
    desconto_medio,
    clientes_unicos,
    vendedores_ativos,
    participacao_receita,
    ranking_concessionaria,
    case
        when receita_mes_anterior is null or receita_mes_anterior = 0 then null
        else (receita_total - receita_mes_anterior) / (receita_mes_anterior)
    end as crescimento_mensal,
    current_timestamp as _dbt_processed_at,
    '7db67ae8-484a-40a2-81a7-8261d7e57cd7' as _dbt_invocation_id
from com_janelas
    );
  
  
[0m11:06:41.310034 [debug] [Thread-2 (]: On model.concessionaria_dbt_course.mart_resumo_mensal: /* {"app": "dbt", "dbt_version": "1.7.13", "profile_name": "concessionaria_dbt_course", "target_name": "dev", "node_id": "model.concessionaria_dbt_course.mart_resumo_mensal"} */

  
    
    

    create  table
      dev.gold.mart_resumo_mensal__dbt_tmp
  
    as (
      with base as (

    select
        id_vendas,
        ano_mes_venda as ano_mes,
        id_vendedores,
        id_concessionarias,
        id_veiculos,
        valor_pago,
        valor_desconto
    from dev.gold.fct_vendas

),

agregado as (

    select
        ano_mes,
        count(id_vendas) as quantidade_vendas,
        sum(valor_pago) as receita_total,
        case
        when count(id_vendas) is null or count(id_vendas) = 0 then null
        else (sum(valor_pago)) / (count(id_vendas))
    end as ticket_medio,
        count(distinct id_vendedores) as vendedores_ativos,
        count(distinct id_concessionarias) as concessionarias_ativas,
        avg(valor_desconto) as desconto_medio
    from base
    group by ano_mes

),

com_crescimento as (

    select
        agregado.*,
        lag(receita_total) over (order by ano_mes) as receita_mes_anterior
    from agregado

),

veiculo_top as (

    select ano_mes, veiculo as veiculo_mais_vendido
    from (
        select
            b.ano_mes,
            v.nome as veiculo,
            count(*) as quantidade,
            row_number() over (
                partition by b.ano_mes order by count(*) desc, v.nome asc
            ) as rn
        from base as b
        left join dev.gold.dim_veiculo as v
            on b.id_veiculos = v.id_veiculos
        group by b.ano_mes, v.nome
    ) as ranked
    where rn = 1

),

vendedor_top as (

    select ano_mes, vendedor as vendedor_maior_receita
    from (
        select
            b.ano_mes,
            v.nome as vendedor,
            sum(b.valor_pago) as receita,
            row_number() over (
                partition by b.ano_mes order by sum(b.valor_pago) desc, v.nome asc
            ) as rn
        from base as b
        left join dev.gold.dim_vendedor as v
            on b.id_vendedores = v.id_vendedores
        group by b.ano_mes, v.nome
    ) as ranked
    where rn = 1

)

select
    c.ano_mes,
    c.receita_total,
    c.quantidade_vendas,
    c.ticket_medio,
    c.vendedores_ativos,
    c.concessionarias_ativas,
    c.desconto_medio,
    case
        when c.receita_mes_anterior is null or c.receita_mes_anterior = 0 then null
        else (c.receita_total - c.receita_mes_anterior) / (c.receita_mes_anterior)
    end as crescimento_mensal_receita,
    vt.veiculo_mais_vendido,
    vd.vendedor_maior_receita,
    current_timestamp as _dbt_processed_at,
    '7db67ae8-484a-40a2-81a7-8261d7e57cd7' as _dbt_invocation_id
from com_crescimento as c
left join veiculo_top as vt on c.ano_mes = vt.ano_mes
left join vendedor_top as vd on c.ano_mes = vd.ano_mes
    );
  
  
