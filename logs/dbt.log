    ) - interval '5 minutes'
    
),
ranked as (
    select 
        source.*,
        row_number() over (partition by id_estados order by _source_modified_at desc) as row_num
    from source
),
deduplicated as (
    select
        id_estados,
        estado,
        sigla,
        data_inclusao,
        data_atualizacao,
        _source_modified_at
    from ranked
    where row_num = 1
),
enriched as (
    select 
        d.id_estados,
        d.estado,
        d.sigla,
        r.regiao,
        r.ordem_regiao,
        d.data_inclusao,
        d.data_atualizacao,
        d._source_modified_at
    from deduplicated d
    left join dev.seeds.seed_regioes_estados as r 
    on d.sigla = r.sigla
)   

select
        id_estados,
        estado,
        sigla,
        regiao,
        ordem_regiao,
        data_inclusao,
