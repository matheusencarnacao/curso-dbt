    create temporary table
      silver_veiculos__dbt_tmp20261013211824096992
  
    as (
      

with source as (

    select
        id_veiculos,
        
    nullif(
        trim(
            regexp_replace(cast(nome as varchar), '\s+', ' ', 'g')
        ), 
        ''
    )
 as nome,
        
    upper(
    nullif(
        trim(
            regexp_replace(cast(tipo as varchar), '\s+', ' ', 'g')
        ), 
        ''
    )
)
 as tipo_normalizado,
        cast(valor as decimal(10, 2)) as valor,
        data_inclusao,
        data_atualizacao,
        greatest(
        coalesce(data_inclusao, timestamp '1900-01-01 00:00:00'),
        coalesce(data_atualizacao, timestamp '1900-01-01 00:00:00')
    ) as _source_modified_at
    from dev.bronze.bronze_veiculos
    where id_veiculos is not null

    
    and _source_modified_at >= (
        select coalesce(max(_source_modified_at), timestamp '1900-01-01 00:00:00')
        from dev.silver.silver_veiculos
    ) - interval '5 minutes'
    

),

ranked as (

    select
        source.*,
        row_number() over (
            partition by id_veiculos
            order by _source_modified_at desc
        ) as _rn
    from source

),

deduplicated as (

    select
        id_veiculos,
        nome,
        tipo_normalizado,
        valor,
        data_inclusao,
        data_atualizacao,
        _source_modified_at
    from ranked
    where _rn = 1

),

tipo_enriquecido as (

    select
        d.id_veiculos,
        d.nome,
        d.tipo_normalizado as tipo,
        coalesce(t.tipo_padronizado, d.tipo_normalizado) as tipo_padronizado,
        coalesce(t.categoria, 'Outros') as categoria_veiculo,
        d.valor,
        d.data_inclusao,
        d.data_atualizacao,
        d._source_modified_at
    from deduplicated as d
    left join dev.seeds.seed_tipos_veiculos as t
        on d.tipo_normalizado = t.tipo_origem

),

segmento_enriquecido as (

    select
        v.id_veiculos,
        v.nome,
        v.tipo,
        v.tipo_padronizado,
        v.categoria_veiculo,
        v.valor,
        s.segmento as segmento_veiculo,
        s.ordem_segmento,
        v.data_inclusao,
        v.data_atualizacao,
        v._source_modified_at
    from tipo_enriquecido as v
    left join dev.seeds.seed_segmentos_veiculos as s
        on
            v.valor >= s.valor_minimo
            and (s.valor_maximo is null or v.valor <= s.valor_maximo)

)

select
    id_veiculos,
    nome,
    tipo,
    tipo_padronizado,
    categoria_veiculo,
    valor,
    segmento_veiculo,
    ordem_segmento,
    data_inclusao,
    data_atualizacao,
    _source_modified_at,
    current_timestamp as _dbt_processed_at,
    '5aa94d1a-a886-4f80-8dc7-98099e75072d' as _dbt_invocation_id
from segmento_enriquecido
    );
  
  
  
